ENVIRONMENT=dev
INTERNAL_API_KEY=
MAX_FILE_SIZE_MB=5
MAX_PDF_PAGES=15
MAX_TEXT_CHARS=60000

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBED_BATCH_SIZE=32
EMBED_CACHE_SIZE=5000

CHROMA_MODE=persistent
CHROMA_PATH=./data/chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=swipex_jobs

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=2
LLM_CACHE_TTL_SECONDS=86400

ATS_KEYWORD_WEIGHT=0.6
ATS_SEMANTIC_WEIGHT=0.4
ATS_THRESHOLD=80.0
SEM_SIM_FLOOR=0.20
SEM_SIM_CEIL=0.75

REC_W_SEMANTIC=0.45
REC_W_SKILL=0.25
REC_W_SWIPE=0.15
REC_W_LOCATION_EXP=0.10
REC_W_FRESH_COMP=0.05

MAX_CONCURRENT_AI_TASKS=4
HIGH_MATCH_DEFAULT_THRESHOLD=80.0
